PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_ID=(default)

# Use one Firebase Admin credential option.
# Keep service account JSON files outside Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Or paste JSON directly / base64 encode it:
# FIREBASE_SERVICE_ACCOUNT=

# Email verification codes for customer registration.
# For Gmail, create an App Password and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="AutoCare <your-gmail-address@gmail.com>"

# Business and invoice PDF details.
BUSINESS_PHONE=+94 77 123 4567
BUSINESS_EMAIL=info@autocare.lk
BUSINESS_ADDRESS=Colombo, Sri Lanka
SERVICE_ADVISOR_NAME=AutoCare Service Team
AUTHORIZED_BY_NAME=Operations Manager
INVOICE_DUE_DAYS=7
BANK_NAME=Commercial Bank of Ceylon
BANK_ACCOUNT_NAME=AutoCare Service Station
BANK_ACCOUNT_NUMBER=replace-with-account-number
BANK_BRANCH=Colombo
