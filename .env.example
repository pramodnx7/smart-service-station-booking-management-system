PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_DATABASE_ID=(default)

# Use one Firebase Admin credential option.
# Keep service account JSON files outside Git.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Or paste JSON directly / base64 encode it:
# FIREBASE_SERVICE_ACCOUNT=

# Supabase is used only for image/document storage. Use a private server-side key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=service-station

# Firestore request timeout and optional automated test accounts.
DATABASE_TIMEOUT_MS=15000
QUEUE_CONTEXT_CACHE_MS=60000
QUEUE_REFERENCE_CACHE_MS=600000
SERVICE_PACKAGE_CACHE_MS=300000
PRICING_PLAN_CACHE_MS=300000
INVENTORY_CATEGORY_CACHE_MS=600000
PUBLIC_RATINGS_CACHE_MS=60000
PUBLIC_PRICING_CACHE_MS=300000
PUBLIC_STATS_CACHE_MS=60000
PUBLIC_CONTENT_CACHE_MS=300000
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PASSWORD=
TEST_TECHNICIAN_EMAIL=
TEST_TECHNICIAN_PASSWORD=

# Optional one-time administrator creation during `npm run firebase:provision`.
# Leave all three blank when an administrator already exists.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Business and invoice PDF details.
BUSINESS_PHONE=+94 77 123 4567
BUSINESS_EMAIL=info@autocare.lk
BUSINESS_ADDRESS=Colombo, Sri Lanka
SERVICE_ADVISOR_NAME=AutoCare Service Team
AUTHORIZED_BY_NAME=Operations Manager
INVOICE_DUE_DAYS=7
BANK_NAME=Commercial Bank of Ceylon
BANK_ACCOUNT_NAME=AutoCare Service Station
BANK_ACCOUNT_NUMBER=replace-with-account-number
BANK_BRANCH=Colombo
