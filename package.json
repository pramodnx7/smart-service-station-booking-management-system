{
  "name": "smart-service-station-booking-management-system",
  "version": "1.0.0",
  "description": "AutoCare smart service station frontend, backend API and Firebase Firestore database connection.",
  "main": "server.js",
  "scripts": {
    "start": "node --use-system-ca server.js",
    "dev": "nodemon --exec \"node --use-system-ca\" server.js",
    "check": "node scripts/check-syntax.js",
    "firebase:provision": "node --use-system-ca scripts/provision-firestore.js",
    "firebase:check-schema": "node --use-system-ca scripts/provision-firestore.js --check",
    "firebase:seed-people": "node --use-system-ca scripts/seed-demo-people.js",
    "firebase:seed-bookings": "node --use-system-ca scripts/seed-demo-bookings.js",
    "firebase:migrate-images": "node --use-system-ca scripts/migrate-images-to-supabase.js --execute",
    "firebase:migrate-images:dry-run": "node --use-system-ca scripts/migrate-images-to-supabase.js",
    "firebase:migrate-static-images": "node --use-system-ca scripts/migrate-static-images-to-supabase.js",
    "test:connection": "node --use-system-ca scripts/check-connection.js",
    "audit:browser": "node scripts/audit-browser.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "playwright-core": "^1.60.0"
  }
}
